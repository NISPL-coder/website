NODE_ENV=development
PORT=4000
CLIENT_ORIGINS=http://localhost:5173,https://nispldemo.vercel.app
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>

JWT_ACCESS_SECRET=<generate-a-long-random-string>
JWT_REFRESH_SECRET=<generate-a-long-random-string>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=nispl_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

BCRYPT_ROUNDS=12
PASSWORD_RESET_EXPIRES_MINUTES=15

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NISPL Security <no-reply@example.com>"
ADMIN_EMAIL=nispldeveloper@gmail.com
APP_BASE_URL=http://localhost:5173

# Sangam CRM API Integration
# Set SANGAM_CRM_SYNC_ENABLED to 'true' to sync with Sangam CRM, or 'false' to skip CRM sync (data still saves into the database)
SANGAM_CRM_SYNC_ENABLED=true
SANGAM_CRM_URL=https://nistally.sangamcrm.com/
SANGAM_CRM_API_BASE=https://nistally.sangamcrm.com/api/v1/
SANGAM_CRM_TOKEN=your-api-key

# Razorpay Payment Gateway
# Set to true for Test Mode (rzp_test_), false for Live Production Mode (rzp_live_)
RAZORPAY_TEST_MODE=true
# Dashboard -> Settings -> API Keys. Never commit the real secret.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_CURRENCY=INR
# Dashboard -> Webhooks -> secret of the payment.captured webhook
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
