# ==============================================================================
# NISPL Career Application Management - Backend Environment Configuration
# ==============================================================================

# Server & Runtime
PORT=5000
NODE_ENV=development
TIMEZONE=Asia/Kolkata
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# File Upload Configuration
MAX_RESUME_SIZE_MB=5
RATE_LIMIT_MAX=10

# ------------------------------------------------------------------------------
# Google Cloud Service Account Authentication
# Option A (Recommended for Local Dev): Path to downloaded service account JSON file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# Option B (Recommended for Production Cloud Hosting e.g. Render, Railway, AWS):
# GOOGLE_SERVICE_ACCOUNT_EMAIL=nispl-career-service@your-project-id.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkq...YOUR_KEY...\n-----END PRIVATE KEY-----\n"
# GOOGLE_PROJECT_ID=nispl-website-12345
# ------------------------------------------------------------------------------

# Google Sheets Configuration
# The ID extracted from your Google Sheet URL: https://docs.google.com/spreadsheets/d/[SPREADSHEET_ID]/edit
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here
GOOGLE_SPREADSHEET_NAME=NISPL Career Applications
GOOGLE_WORKSHEET_NAME=Applications

# Google Drive Configuration
# The ID extracted from your Google Drive Folder URL: https://drive.google.com/drive/folders/[FOLDER_ID]
# Leave empty to automatically create or find 'NISPL Resumes(Website)' folder
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
GOOGLE_DRIVE_FOLDER_NAME=NISPL Resumes(Website)

# ------------------------------------------------------------------------------
# Email Notification Configuration (Nodemailer)
# Primary HR recipient for applications
HR_NOTIFICATION_EMAIL=netinfotechsystem@gmail.com

# SMTP Provider (e.g. Gmail App Password or Google Workspace SMTP relay)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=netinfotechsystem@gmail.com
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="NISPL Career Portal" <netinfotechsystem@gmail.com>
ATTACH_RESUME_IN_EMAIL=false
