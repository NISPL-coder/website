# Frontend Environment Configuration (Vite)
VITE_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
VITE_GOOGLE_PLACE_ID=your_google_place_id_here

# Backend API Base URL (leave empty in local development to use Vite proxy /api)
# For production deployment where backend is hosted on a separate domain (e.g. Render/Heroku):
# VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_BASE_URL=

# Note: Backend specific variables (Google Service Account, SMTP, Sheets ID, Drive Folder ID)
# are configured in backend/.env (refer to backend/.env.example). Never prefix secrets with VITE_
